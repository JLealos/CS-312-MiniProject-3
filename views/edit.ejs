<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
    <title>Edit post | The Community Notebook</title>
  </head>
  <body>
    <nav class="navbar border-bottom bg-white">
      <div class="container">
        <a class="navbar-brand" href="/">The Community Notebook</a>
      </div>
    </nav>

    <main class="container py-4" style="max-width: 720px;">
      <a href="/" class="text-secondary">Back to all posts</a>
      <section class="mt-3">
        <h1 class="h2">Edit post</h1>

        <% if (error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>

        <form action="/posts/<%= post.id %>/edit" method="post">
          <div class="mb-3">
            <label class="form-label" for="author">Your name</label>
            <input class="form-control" id="author" name="author" type="text" value="<%= post.author || '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="title">Title</label>
            <input class="form-control" id="title" name="title" type="text" value="<%= post.title || '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="tags">Tags <span class="text-secondary small">comma-separated</span></label>
            <input class="form-control" id="tags" name="tags" type="text" value="<%= post.tagsInput || post.tags.join(', ') %>">
          </div>
          <div class="mb-3">
            <label class="form-label" for="content">Blog content</label>
            <textarea class="form-control" id="content" name="content" rows="9" required><%= post.content || '' %></textarea>
          </div>
          <button class="btn btn-primary" type="submit">Save changes</button>
          <a class="btn btn-link" href="/">Cancel</a>
        </form>
      </section>
    </main>
  </body>
</html>
