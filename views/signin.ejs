<!DOCTYPE html>
<html lang="en">
  <head><%- include('partials/head') %></head>
  <body>
    <%- include('partials/nav') %>
    <main class="container py-5 auth-page">
      <section class="card p-4">
        <h1 class="h2">Welcome back</h1>
        <p class="text-secondary">Sign in to write and manage your posts.</p>
        <% if (registered) { %>
          <div class="alert alert-success" role="status">Account created. You can now sign in.</div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>
        <form action="/signin" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label class="form-label" for="user_id">User ID</label>
            <input class="form-control" id="user_id" name="user_id" autocomplete="username" maxlength="255" value="<%= formData.user_id || '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" maxlength="1024" required>
          </div>
          <button class="btn btn-primary w-100" type="submit">Sign in</button>
        </form>
        <p class="mt-3 mb-0">New here? <a href="/signup">Create an account</a></p>
      </section>
    </main>
  </body>
</html>
