<nav class="navbar border-bottom bg-white">
  <div class="container gap-2">
    <a class="navbar-brand" href="/">The Community Notebook</a>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <% if (currentUser) { %>
        <span class="text-secondary small">Hi, <%= currentUser.name %></span>
        <form action="/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-outline-secondary" type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a class="btn btn-sm btn-outline-secondary" href="/signin">Sign in</a>
        <a class="btn btn-sm btn-primary" href="/signup">Sign up</a>
      <% } %>
    </div>
  </div>
</nav>
