<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
  </head>
  <body>
    <main>
      <h1><%= pageTitle %></h1>

      <section aria-labelledby="create-post-heading">
        <h2 id="create-post-heading">Create a post</h2>

        <% if (error) { %>
          <p role="alert"><%= error %></p>
        <% } %>

        <form action="/posts" method="post">
          <div>
            <label for="author">Your name</label>
            <input id="author" name="author" type="text" value="<%= formData.author || '' %>" required>
          </div>

          <div>
            <label for="title">Title</label>
            <input id="title" name="title" type="text" value="<%= formData.title || '' %>" required>
          </div>

          <div>
            <label for="tags">Tags</label>
            <input id="tags" name="tags" type="text" value="<%= formData.tags || '' %>" placeholder="technology, learning">
          </div>

          <div>
            <label for="content">Blog content</label>
            <textarea id="content" name="content" rows="8" required><%= formData.content || '' %></textarea>
          </div>

          <button type="submit">Publish post</button>
        </form>
      </section>

      <section aria-labelledby="posts-heading">
        <h2 id="posts-heading">Published posts</h2>

        <form action="/" method="get">
          <label for="tag-filter">Filter by tag</label>
          <select id="tag-filter" name="tag">
            <option value="">All tags</option>
            <% availableTags.forEach((tag) => { %>
              <option value="<%= tag %>" <%= selectedTag === tag ? 'selected' : '' %>><%= tag %></option>
            <% }) %>
          </select>

          <label for="sort-order">Sort by date</label>
          <select id="sort-order" name="sort">
            <option value="newest" <%= sortOrder === 'newest' ? 'selected' : '' %>>Newest first</option>
            <option value="oldest" <%= sortOrder === 'oldest' ? 'selected' : '' %>>Oldest first</option>
          </select>

          <button type="submit">Apply filters</button>
        </form>

        <% if (posts.length === 0) { %>
          <p><%= selectedTag ? `No posts found with the tag "${selectedTag}".` : 'No posts yet. Create the first one above.' %></p>
        <% } %>

        <% posts.forEach((post) => { %>
          <article>
            <h3><%= post.title %></h3>
            <p>By <%= post.author %> on <%= post.createdAt.toLocaleString() %></p>
            <% if (post.tags.length > 0) { %>
              <p>Tags: <%= post.tags.join(', ') %></p>
            <% } %>
            <p><%= post.content %></p>

            <form action="/posts/<%= post.id %>/react" method="post">
              <button type="submit" name="reaction" value="like">Like (<%= post.likes %>)</button>
              <button type="submit" name="reaction" value="dislike">Dislike (<%= post.dislikes %>)</button>
            </form>

            <a href="/posts/<%= post.id %>/edit">Edit</a>
            <form action="/posts/<%= post.id %>/delete" method="post">
              <button type="submit">Delete</button>
            </form>
          </article>
        <% }) %>
      </section>
    </main>
  </body>
</html>